(export (version "E")
  (components
    (comp (ref "TP1") (value "VM_IN") (footprint "X"))
    (comp (ref "TP2") (value "GND") (footprint "X"))
    (comp (ref "TP3") (value "PHASE A") (footprint "X"))
    (comp (ref "C1") (value "100uF 63V") (footprint "CAP-TH_BD8.0"))
    (comp (ref "C2") (value "10uF") (footprint "X"))
    (comp (ref "C3") (value "1uF") (footprint "X"))
    (comp (ref "L1") (value "10uH") (footprint "X"))
    (comp (ref "U1") (value "TLV75733") (footprint "X"))
    (comp (ref "U2") (value "LM5164") (footprint "X"))
    (comp (ref "U3") (value "INA240A1") (footprint "X"))
    (comp (ref "Q1") (value "NMOS") (footprint "X"))
    (comp (ref "Q2") (value "NMOS") (footprint "X"))
    (comp (ref "R1") (value "3m") (footprint "X"))
    (comp (ref "R2") (value "10k") (footprint "X"))
    (comp (ref "D1") (value "LED green (power)") (footprint "X"))
    (comp (ref "SW1") (value "Reset switch") (footprint "X"))
    (comp (ref "J1") (value "SWD 2x5") (footprint "X"))
    (comp (ref "J2") (value "JST-GH 4p") (footprint "X"))
  )
  (nets
    (net (code "1") (name "/VM_IN")
      (node (ref "TP1") (pin "1") (pintype "passive"))
      (node (ref "C1") (pin "1") (pintype "passive"))
      (node (ref "U2") (pin "2") (pinfunction "VIN_2") (pintype "power_in"))
      (node (ref "Q1") (pin "5") (pinfunction "D_5") (pintype "passive"))
    )
    (net (code "2") (name "GND")
      (node (ref "TP2") (pin "1") (pintype "passive"))
      (node (ref "C1") (pin "2") (pintype "passive"))
      (node (ref "C2") (pin "2") (pintype "passive"))
      (node (ref "C3") (pin "2") (pintype "passive"))
      (node (ref "U1") (pin "2") (pinfunction "GND_2") (pintype "power_in"))
      (node (ref "U2") (pin "1") (pinfunction "GND_1") (pintype "power_in"))
      (node (ref "U3") (pin "2") (pinfunction "GND_2") (pintype "power_in"))
      (node (ref "U3") (pin "3") (pinfunction "REF2_3") (pintype "passive"))
      (node (ref "R1") (pin "2") (pintype "passive"))
      (node (ref "D1") (pin "2") (pinfunction "K_2") (pintype "passive"))
      (node (ref "SW1") (pin "2") (pintype "passive"))
      (node (ref "J1") (pin "3") (pintype "passive"))
      (node (ref "J2") (pin "1") (pintype "passive"))
    )
    (net (code "3") (name "/regulators/BUCK_SW")
      (node (ref "U2") (pin "8") (pinfunction "SW_8") (pintype "power_out"))
      (node (ref "L1") (pin "1") (pintype "passive"))
    )
    (net (code "4") (name "+5V")
      (node (ref "L1") (pin "2") (pintype "passive"))
      (node (ref "C2") (pin "1") (pintype "passive"))
      (node (ref "U1") (pin "1") (pinfunction "IN_1") (pintype "power_in"))
    )
    (net (code "5") (name "+3V3")
      (node (ref "U1") (pin "5") (pinfunction "OUT_5") (pintype "power_out"))
      (node (ref "C3") (pin "1") (pintype "passive"))
      (node (ref "U3") (pin "6") (pinfunction "VS_6") (pintype "power_in"))
      (node (ref "U3") (pin "7") (pinfunction "REF1_7") (pintype "passive"))
      (node (ref "J1") (pin "1") (pintype "passive"))
    )
    (net (code "6") (name "/PHASE_A")
      (node (ref "TP3") (pin "1") (pintype "passive"))
      (node (ref "Q1") (pin "1") (pinfunction "S_1") (pintype "passive"))
      (node (ref "Q2") (pin "5") (pinfunction "D_5") (pintype "passive"))
    )
    (net (code "7") (name "/LS_SRC_A")
      (node (ref "Q2") (pin "1") (pinfunction "S_1") (pintype "passive"))
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "U3") (pin "8") (pinfunction "IN+_8") (pintype "passive"))
    )
    (net (code "8") (name "/CSA_OUT")
      (node (ref "U3") (pin "5") (pinfunction "OUT_5") (pintype "output"))
      (node (ref "R2") (pin "1") (pintype "passive"))
    )
    (net (code "9") (name "/LED_A")
      (node (ref "R2") (pin "2") (pintype "passive"))
      (node (ref "D1") (pin "1") (pinfunction "A_1") (pintype "passive"))
    )
    (net (code "10") (name "/mcu/NRST")
      (node (ref "SW1") (pin "1") (pintype "passive"))
      (node (ref "J1") (pin "10") (pintype "passive"))
    )
    (net (code "11") (name "/io/UART_TX")
      (node (ref "J2") (pin "3") (pintype "passive"))
    )
    (net (code "12") (name "/io/UART_RX")
      (node (ref "J2") (pin "4") (pintype "passive"))
    )
  )
)
